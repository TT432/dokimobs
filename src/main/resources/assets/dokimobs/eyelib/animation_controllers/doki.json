{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.mdsj_wanderer.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "flee": "query.is_avoiding_mobs",
              "float": "q.is_in_water"
            }
          ],
          "blend_transition": 0.2,
          "animations": [
            {
              "move": "query.modified_move_speed*1.4"
            }
          ]
        },
        "flee": {
          "transitions": [
            {
              "float": "q.is_in_water",
              "default": "!query.is_avoiding_mobs&&query.any_animation_finished"
            }
          ],
          "blend_transition": 0.2,
          "animations": [
            {
              "run": "query.modified_move_speed*1.4"
            }
          ]
        },
        "float": {
          "transitions": [
            {
              "default": "!q.is_in_water&&q.is_on_ground"
            }
          ],
          "blend_transition": 0.2,
          "animations": [
            {
              "float": "q.is_moving",
              "swim_idle": "!q.is_moving"
            }
          ]
        }
      }
    },
    "controller.animation.mdsj_villager.ride": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "is_riding": "q.is_riding"
            }
          ],
          "animations": [
            {
              "controller_move": "1.0",
              "controller_jump": "1.0",
              "controller_land": "1.0",
              "controller_fall": "1.0"
            }
          ]
        },
        "is_riding": {
          "transitions": [
            {
              "default": "!q.is_riding"
            }
          ],
          "animations": [
            {
              "riding.legs": "1.0",
              "contraction": "1.0"
            }
          ]
        }
      }
    },
    "controller.animation.doki_guardian.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "idle": "!q.is_in_water&&!q.is_moving",
              "swim_idle": "q.is_in_water&&!q.is_moving",
              "walk": "!q.is_in_water&&q.is_moving",
              "swim": "q.is_in_water&&q.is_moving"
            }
          ]
        }
      }
    },
    "controller.animation.doki_wolf.movement": {
      "initial_state": "walk",
      "states": {
        "walk": {
          "transitions": [
            {
              "run": "q.modified_move_speed>0.6"
            },
            {
              "float": "q.is_in_water"
            },
            {
              "air": "!q.is_on_ground&&!q.is_in_water"
            }
          ],
          "blend_transition": 0.12,
          "animations": [
            {
              "walk": "q.modified_move_speed*1.6"
            }
          ]
        },
        "run": {
          "transitions": [
            {
              "walk": "q.modified_move_speed<0.3&&q.any_animation_finished"
            },
            {
              "float": "q.is_in_water"
            },
            {
              "air": "!q.is_on_ground&&!q.is_in_water"
            }
          ],
          "blend_transition": 0.18,
          "animations": [
            {
              "run": "q.modified_move_speed*1.6"
            }
          ]
        },
        "float": {
          "transitions": [
            {
              "walk": "!q.is_in_water&&q.is_on_ground"
            }
          ],
          "blend_transition": 0.24,
          "animations": [
            {
              "swim": "q.is_moving",
              "swim_idle": "!q.is_moving"
            }
          ]
        },
        "air": {
          "transitions": [
            {
              "walk": "q.is_on_ground&&!q.is_in_water"
            },
            {
              "float": "q.is_in_water"
            }
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.doki_blaze.spear": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "idle_state": "!q.has_target",
              "attack_state": "q.has_target"
            }
          ]
        }
      }
    },
    "controller.animation.doki_wolf.tail": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "tail": "!q.is_sleeping&&!q.is_moving&&q.is_on_ground&&!q.is_in_water"
            }
          ]
        }
      }
    },
    "controller.animation.doki_wolf.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "attacking": "q.is_attacking||q.is_angry"
            }
          ]
        },
        "attacking": {
          "transitions": [
            {
              "default": "!q.is_attacking&&!q.is_angry&&q.any_animation_finished"
            }
          ],
          "blend_transition": 0.1,
          "animations": [
            {
              "attack": "1.0"
            }
          ]
        }
      }
    },
    "controller.animation.doki_pillager.movement": {
      "initial_state": "walk",
      "states": {
        "walk": {
          "transitions": [
            {
              "run": "q.has_target&&q.is_moving"
            },
            {
              "float": "q.is_in_water"
            },
            {
              "air": "!q.is_on_ground&&!q.is_in_water"
            }
          ],
          "blend_transition": 0.12,
          "animations": [
            {
              "walk": "q.modified_move_speed*1.6"
            }
          ]
        },
        "run": {
          "transitions": [
            {
              "walk": "!q.has_target"
            },
            {
              "float": "q.is_in_water"
            },
            {
              "air": "!q.is_on_ground&&!q.is_in_water"
            }
          ],
          "blend_transition": 0.12,
          "animations": [
            {
              "run": "q.modified_move_speed*1.36"
            }
          ]
        },
        "float": {
          "transitions": [
            {
              "walk": "!q.is_in_water&&q.is_on_ground"
            }
          ],
          "blend_transition": 0.24,
          "animations": [
            {
              "float": "1.0"
            }
          ]
        },
        "air": {
          "transitions": [
            {
              "walk": "q.is_on_ground&&!q.is_in_water"
            },
            {
              "float": "q.is_in_water"
            }
          ],
          "blend_transition": 0.15,
          "animations": [
            {
              "jump": "1.0"
            }
          ]
        }
      }
    },
    "controller.animation.doki_pillager.idle": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "away": "q.is_moving||!q.is_on_ground||q.is_in_water"
            }
          ],
          "blend_transition": 0.3,
          "animations": [
            {
              "idle_0": "!query.is_sitting"
            },
            {
              "idle_timer": "1.0"
            }
          ]
        },
        "away": {
          "transitions": [
            {
              "idle": "!q.is_moving&&q.is_on_ground&&!q.is_in_water"
            }
          ],
          "animations": [
            {
              "idle_timer": "1.0"
            }
          ]
        }
      }
    },
    "controller.animation.doki_wolf.idle": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "away": "q.is_moving||!q.is_on_ground||q.is_in_water"
            }
          ],
          "blend_transition": 0.3,
          "animations": [
            {
              "idle_0": "!query.is_sitting"
            },
            {
              "idle_timer": "1.0"
            }
          ]
        },
        "away": {
          "transitions": [
            {
              "idle": "!q.is_moving&&q.is_on_ground&&!q.is_in_water"
            }
          ],
          "animations": [
            {
              "idle_timer": "1.0"
            }
          ]
        }
      }
    },
    "controller.animation.doki_wandering_trader.idle": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "away": "q.is_moving||!q.is_on_ground||q.is_in_water"
            }
          ],
          "blend_transition": 0.3,
          "animations": [
            {
              "idle_0": "!query.is_sitting"
            },
            {
              "idle_timer": "1.0"
            }
          ]
        },
        "away": {
          "transitions": [
            {
              "idle": "!q.is_moving&&q.is_on_ground&&!q.is_in_water"
            }
          ],
          "animations": [
            {
              "idle_timer": "1.0"
            }
          ]
        }
      }
    },
    "controller.animation.doki_pillager.arms": {
      "initial_state": "down",
      "states": {
        "down": {
          "transitions": [
            {
              "up": "q.is_attacking||q.has_target"
            },
            {
              "quiet": "!q.is_in_water&&(q.is_moving||!q.is_on_ground)"
            }
          ],
          "animations": [
            {
              "arms_down": "1.0"
            }
          ]
        },
        "up": {
          "transitions": [
            {
              "down": "!q.is_attacking&&!q.has_target"
            },
            {
              "quiet": "!q.is_in_water&&(q.is_moving||!q.is_on_ground)"
            }
          ],
          "blend_transition": 0.15,
          "animations": [
            {
              "raise_arms": "1.0"
            }
          ]
        },
        "quiet": {
          "transitions": [
            {
              "down": "q.is_in_water||(q.is_on_ground&&!q.is_moving)"
            }
          ]
        }
      }
    },
    "controller.animation.doki_blaze.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "idle": "!q.is_moving",
              "move": "q.is_moving"
            }
          ]
        }
      }
    },
    "controller.animation.doki_blaze.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "attacking": "q.is_attacking"
            }
          ]
        },
        "attacking": {
          "transitions": [
            {
              "default": "!q.is_attacking&&q.any_animation_finished"
            }
          ],
          "blend_transition": 0.1,
          "animations": [
            {
              "attack": "1.0"
            }
          ]
        }
      }
    }
  }
}
